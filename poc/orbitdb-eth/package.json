{
  "name": "orbitdb-eth-poc",
  "version": "0.0.1",
  "description": "POC: OrbitDB con identidad Ethereum (DID derivado de la address) + access controller validado on-chain. Mide el costo de bundling en Parcel.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "parcel index.html",
    "build": "parcel build index.html --dist-dir dist --no-cache"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.0",
    "@chainsafe/libp2p-noise": "^16.0.0",
    "@chainsafe/libp2p-yamux": "^7.0.0",
    "@libp2p/circuit-relay-v2": "^3.0.0",
    "@libp2p/identify": "^3.0.0",
    "@libp2p/tcp": "^10.1.19",
    "@libp2p/webrtc": "^5.0.0",
    "@libp2p/websockets": "^9.0.0",
    "@multiformats/multiaddr": "^12.5.1",
    "@orbitdb/core": "^2.4.3",
    "blockstore-idb": "^2.0.0",
    "datastore-idb": "^3.0.0",
    "ethers": "^6.15.0",
    "helia": "^5.1.0",
    "libp2p": "^2.1.0"
  },
  "devDependencies": {
    "parcel": "^2.11.0"
  }
}
